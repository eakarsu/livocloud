# Copy to .env only for local tooling; servlet containers must receive these as
# environment variables. Never commit real values.
LIVOCLOUD_DB_DRIVER=org.postgresql.Driver
LIVOCLOUD_DB_URL=jdbc:postgresql://localhost:5432/livocloud
LIVOCLOUD_DB_USERNAME=livocloud
LIVOCLOUD_DB_PASSWORD=replace-with-a-local-password
LIVOCLOUD_PUBLIC_BASE_URL=http://localhost:8080/LivoCloud

# Required only when verification email delivery is enabled.
LIVOCLOUD_MAILGUN_API_KEY=replace-with-mailgun-key
LIVOCLOUD_MAILGUN_API_URL=https://api.mailgun.net/v3/example.invalid/messages
LIVOCLOUD_MAIL_FROM=LivoCloud <no-reply@example.invalid>
